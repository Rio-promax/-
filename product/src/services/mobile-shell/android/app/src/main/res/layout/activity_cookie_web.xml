<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <WebView
        android:id="@+id/cookie_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/cookie_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF1F1EF"
        android:ellipsize="end"
        android:maxLines="4"
        android:padding="10dp"
        android:text="登录完成后点「读取 Cookie」。"
        android:textColor="#FF5B6165"
        android:textIsSelectable="true"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/cookie_read"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="读取 Cookie" />

        <Button
            android:id="@+id/cookie_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="关闭" />
    </LinearLayout>

</LinearLayout>
