<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/share_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/share_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_dialog_title"
        android:textColor="#2D2019"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/share_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/share_state_submitting"
        android:textColor="#6B5744"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/share_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:indeterminate="true"
        android:indeterminateTint="#B76D2D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/share_stay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/share_button_primary"
            android:backgroundTint="@null"
            android:text="@string/share_action_stay"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/share_close"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/share_button_secondary"
            android:backgroundTint="@null"
            android:text="@string/share_action_back"
            android:textAllCaps="false"
            android:textColor="#2D2019"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
